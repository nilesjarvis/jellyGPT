# Jellyfin connection
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=replace-me
# Alternative for local testing when you do not use an API key
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=

# Read-only mounted Jellyfin data paths inside the jellyGPT container
PLAYBACK_DB=/jellyfin-data/playback_reporting.db
JELLYFIN_DB=/jellyfin-data/jellyfin.db

# Cache/output location
CACHE_DIR=/cache
INDEX_PATH=
INDEX_MAX_AGE_SECONDS=3600
INDEX_LIMIT_PER_SOURCE=5000
INDEX_HISTORY_DAYS=365

# Recommendation generation
RECS_REFRESH_INTERVAL=30m
RECS_DEFAULT_ALGO=blended
RECS_ALGOS=existing_logic_like,recency_popularity,label_profile,blended,llm_rerank

# Optional local AI
ENABLE_LLM_RERANK=false
ENABLE_LLM_LABELING=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Periodic AI taste-profile Markdown generation
ENABLE_PROFILE_UPDATES=false
TASTE_PROFILE_PATH=/cache/profiles/default.md
PROFILE_REFRESH_INTERVAL_SECONDS=3600
PROFILE_CHUNK_EVENTS=50
PROFILE_MAX_EVENTS_PER_RUN=1000
PROFILE_REQUIRE_OLLAMA=false
